---
import AuditSoon from '../../components/AuditSoon.astro';
import OnlineAudit from '../../components/OnlineAudit.astro';
import { onlineAuditReady } from '../../config';
import { useTranslations } from '../../i18n';
import Base from '../../layouts/Base.astro';

const t = useTranslations('en').auditPage;
---

<Base lang="en" page="audit" title={t.title} description={onlineAuditReady ? t.online.description : t.description}>
  {onlineAuditReady ? <OnlineAudit lang="en" /> : <AuditSoon lang="en" />}
</Base>
