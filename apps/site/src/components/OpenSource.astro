---
import { ISSUES_URL, REPO_URL } from '../config';
import { useTranslations, type Lang } from '../i18n';
import { highlightYaml } from '../lib/highlight';
import Icon3D from './Icon3D.astro';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang).oss;
---

<section class="section" aria-labelledby="oss-title">
  <div class="ambient" aria-hidden="true"></div>
  <div class="container oss">
    <div class="text lift" data-reveal="1">
      <Icon3D name="code" size={72} />
      <h2 id="oss-title">{t.title}</h2>
      <p>{t.lead}</p>
      <div class="actions">
        <a class="btn btn-primary" href={REPO_URL}>{t.repo}</a>
        <a class="btn btn-secondary" href={ISSUES_URL}>{t.issues}</a>
      </div>
    </div>
    <figure class="card" data-reveal="2">
      <figcaption>
        <span>{t.cardLabel}</span>
        <code>{t.cardFile}</code>
      </figcaption>
      <!-- tabindex: lets keyboard users scroll long lines (WCAG 2.1.1) -->
      <pre tabindex="0" aria-label={t.cardFile}><code set:html={highlightYaml(t.card)} /></pre>
    </figure>
  </div>
</section>

<style>
  .oss {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--sl-space-8);
    align-items: center;
  }
  h2 {
    margin-top: var(--sl-space-6);
    font-size: var(--sl-fs-section);
    letter-spacing: -0.032em;
    line-height: 1.08;
  }
  .text p {
    margin-top: var(--sl-space-5);
    color: var(--sl-text-2);
    font-size: var(--sl-fs-sub);
    line-height: 1.45;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sl-space-3);
    margin-top: var(--sl-space-6);
  }

  .card {
    margin: 0;
    overflow: hidden;
    border-radius: var(--sl-radius-xl);
    background: var(--sl-glass-card);
    -webkit-backdrop-filter: blur(24px) saturate(1.7);
    backdrop-filter: blur(24px) saturate(1.7);
    box-shadow:
      inset 0 1px 0 0 var(--sl-lg-rim),
      inset 0 0 0 1px var(--sl-lg-edge),
      var(--sl-shadow-l);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 16px;
    padding: 16px 24px;
    border-bottom: 1px solid var(--sl-lg-edge);
    color: var(--sl-text-2);
    font-size: 13px;
  }
  figcaption code { font-size: 13px; }
  pre {
    margin: 0;
    padding: 24px;
    overflow-x: auto;
    font-size: 14px;
    line-height: 1.7;
  }
  pre:focus-visible { outline-offset: -3px; }

  @media (max-width: 899px) {
    .oss { grid-template-columns: minmax(0, 1fr); }
  }
  /* The sample card is a wide YAML file: on a phone it only shows cut-off lines */
  @media (max-width: 639px) {
    .card { display: none; }
  }
</style>
