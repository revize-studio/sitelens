---
// Generic look-alikes of system apps for the hero dock: drawn from scratch, no Apple artwork.
// Colours come from --sl-app-* tokens; in the dark theme plates turn graphite and the colour
// moves into the glyph, like macOS dark icons.
export type DockApp = 'files' | 'browser' | 'mail' | 'notes' | 'terminal' | 'preview' | 'settings' | 'trash';

interface Props {
  app: DockApp;
}

const { app } = Astro.props;
const plate: Record<Exclude<DockApp, 'trash'>, string> = {
  files: 'url(#da-files)',
  browser: 'url(#da-plate)',
  mail: 'url(#da-mail)',
  notes: 'url(#da-plate)',
  terminal: 'url(#da-ink)',
  preview: 'url(#da-plate)',
  settings: 'url(#da-gear)',
};
---

<svg class="dock-icon" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  {
    app !== 'trash' && (
      <>
        <rect x="4" y="4" width="56" height="56" rx="13.5" fill={plate[app]} />
      </>
    )
  }

  {
    app === 'files' && (
      <>
        <path class="da-folder" opacity="0.7" d="M15 22a4 4 0 0 1 4-4h9.5l4 4.5H45a4 4 0 0 1 4 4V30H15Z" />
        <path class="da-folder" d="M15 28.5h34V44a4 4 0 0 1-4 4H19a4 4 0 0 1-4-4Z" />
      </>
    )
  }

  {
    app === 'browser' && (
      <>
        <circle cx="32" cy="32" r="21" fill="url(#da-compass)" />
        <circle cx="32" cy="32" r="21" fill="none" class="da-line" stroke-width="1" />
        <g class="da-glyph" stroke-width="1.6" stroke-linecap="round">
          <path d="M32 13.5v4M32 46.5v4M13.5 32h4M46.5 32h4M18.9 18.9l2.8 2.8M42.3 42.3l2.8 2.8M18.9 45.1l2.8-2.8M42.3 21.7l2.8-2.8" />
        </g>
        <path class="da-red" d="M43.5 20.5 34.6 34.6 29.4 29.4Z" />
        <path class="da-white" d="M20.5 43.5 29.4 29.4 34.6 34.6Z" />
      </>
    )
  }

  {
    app === 'mail' && (
      <>
        <rect x="14" y="20" width="36" height="25" rx="3.5" class="da-envelope" />
        <path d="M15.5 22.5 32 34.5l16.5-12" fill="none" class="da-flap" stroke-width="2.6" stroke-linejoin="round" />
      </>
    )
  }

  {
    app === 'notes' && (
      <g clip-path="url(#da-squircle)">
        <rect x="4" y="4" width="56" height="17" fill="url(#da-yellow)" />
        <path d="M10 21h44" class="da-line" stroke-width="1.4" stroke-dasharray="2 2.4" />
        <path d="M13 30h38M13 37.5h38M13 45h24" class="da-line" stroke-width="2" stroke-linecap="round" />
      </g>
    )
  }

  {
    app === 'terminal' && (
      <>
        <path d="M18 25l8 6.5-8 6.5" fill="none" class="da-glyph" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M30 41h15" class="da-glyph" stroke-width="3.4" stroke-linecap="round" />
      </>
    )
  }

  {
    app === 'preview' && (
      <>
        <rect x="17" y="13" width="25" height="33" rx="2.5" class="da-sheet da-line" stroke-width="1" transform="rotate(-9 29.5 29.5)" />
        <rect x="22" y="17" width="25" height="33" rx="2.5" class="da-sheet da-line" stroke-width="1" />
        <rect x="25" y="21" width="19" height="13" rx="1.5" fill="url(#da-sky)" />
        <path d="M25 34l6-6.5 4.5 4.5 3-3 5.5 5Z" class="da-white" opacity="0.85" />
        <circle cx="44" cy="44" r="6.5" class="da-sheet da-loupe" stroke-width="2.6" />
        <path d="M48.6 48.6 53 53" class="da-loupe" stroke-width="3.2" stroke-linecap="round" />
      </>
    )
  }

  {
    app === 'settings' && (
      <>
        <circle cx="32" cy="32" r="16" fill="none" class="da-glyph" stroke-width="6" stroke-dasharray="4.6 3.78" />
        <circle cx="32" cy="32" r="12.5" class="da-glyph-fill" />
        <circle cx="32" cy="32" r="5.5" class="da-hub" />
      </>
    )
  }

  {
    app === 'trash' && (
      <>
        <path d="M17 17.5h30l-2.6 36a3.5 3.5 0 0 1-3.5 3.2H23.1a3.5 3.5 0 0 1-3.5-3.2Z" fill="url(#da-plate)" class="da-line" stroke-width="1" opacity="0.92" />
        <rect x="14.5" y="13" width="35" height="5.5" rx="2.75" fill="url(#da-plate)" class="da-line" stroke-width="1" />
        <path d="M26 24v27M32 24v27M38 24v27" class="da-line" stroke-width="1.8" stroke-linecap="round" />
      </>
    )
  }

  {app !== 'trash' && <rect x="4" y="4" width="56" height="56" rx="13.5" fill="url(#da-gloss)" />}
</svg>
