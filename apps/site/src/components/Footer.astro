---
import { CONTACT_EMAIL, ISSUES_URL, LICENSE_URL, REPO_URL, STUDIO_NAME, STUDIO_URL } from '../config';
import { routes, useTranslations, type Lang, type PageKey } from '../i18n';
import { LOGO_VIEWBOX } from '../lib/logo';

interface Props {
  lang: Lang;
  page?: PageKey;
}

const { lang, page = 'home' } = Astro.props;
const t = useTranslations(lang);
const f = t.footer;
const home = routes.home[lang];
const other: Lang = lang === 'pl' ? 'en' : 'pl';
const year = new Date().getFullYear();

const columns = [
  {
    title: f.product,
    links: [
      { href: `${home}#${t.checks.id}`, label: f.links.checks },
      { href: `${home}#${t.report.id}`, label: f.links.report },
      { href: `${home}#${t.start.id}`, label: f.links.start },
      { href: routes.terminal[lang], label: f.links.terminal },
      { href: routes.audit[lang], label: f.links.audit },
      { href: routes.brandbook[lang], label: f.links.brandbook },
    ],
  },
  {
    title: f.project,
    links: [
      { href: REPO_URL, label: f.links.repo },
      { href: ISSUES_URL, label: f.links.issues },
      { href: LICENSE_URL, label: f.links.license },
    ],
  },
  {
    title: f.contact,
    links: [
      { href: `mailto:${CONTACT_EMAIL}`, label: CONTACT_EMAIL },
      { href: routes.privacy[lang], label: f.links.privacy },
      { href: routes.terms[lang], label: f.links.terms },
    ],
  },
];
---

<footer class="footer">
  <div class="ambient footer-light" aria-hidden="true"></div>
  <div class="container">
    <div class="panel tile">
      <div class="intro">
        <a class="logo" href={home} aria-label={t.nav.home}>
          <svg viewBox={LOGO_VIEWBOX} aria-hidden="true" focusable="false"><use href="#logo-nav-art"></use></svg>
        </a>
        <p class="tagline">{f.tagline}</p>
        <div class="actions">
          <a class="btn btn-primary btn-small" href={routes.audit[lang]}>{t.nav.check}</a>
          <a class="btn btn-secondary btn-small" href={REPO_URL}>
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
              ></path>
            </svg>
            {f.links.repo}
          </a>
        </div>
      </div>

      <div class="cols">
        {
          columns.map((col) => (
            <nav class="col" aria-label={col.title}>
              <h2>{col.title}</h2>
              <ul role="list">
                {col.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>

    <div class="legal">
      <p>© {year} {STUDIO_NAME} {f.oss}</p>
      <div class="legal-links">
        <a href={routes[page][other]} hreflang={t.nav.otherLang.hreflang} lang={t.nav.otherLang.hreflang}>{t.nav.otherLang.label}</a>
        <a href={STUDIO_URL}>{f.builtBy}</a>
      </div>
    </div>
  </div>
  <div class="wordmark" aria-hidden="true"></div>
</footer>

<style>
  .footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: var(--sl-space-8);
    font-size: var(--sl-fs-small);
  }
  .footer-light {
    background:
      radial-gradient(640px 420px at 18% 58%, var(--sl-glow-1), transparent 70%),
      radial-gradient(600px 420px at 84% 40%, var(--sl-glow-2), transparent 70%),
      radial-gradient(820px 360px at 50% 100%, var(--sl-glow-3), transparent 70%);
    -webkit-mask-image: linear-gradient(transparent, var(--sl-text) 30%);
    mask-image: linear-gradient(transparent, var(--sl-text) 30%);
  }

  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 2fr);
    gap: var(--sl-space-7) var(--sl-space-8);
    padding: clamp(28px, 4vw, 52px);
  }

  .logo {
    display: inline-flex;
    border-radius: 10px;
    color: var(--sl-text);
  }
  .logo :global(svg) { width: auto; height: 34px; overflow: visible; }
  .tagline {
    max-width: 18ch;
    margin-top: var(--sl-space-5);
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
    text-wrap: balance;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sl-space-3);
    margin-top: var(--sl-space-6);
  }
  .actions svg { width: 16px; height: 16px; }

  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sl-space-6);
  }
  h2 {
    margin-bottom: var(--sl-space-4);
    color: var(--sl-text);
    font-size: var(--sl-fs-small);
    font-weight: 600;
    letter-spacing: 0;
  }
  ul {
    display: grid;
    gap: var(--sl-space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .col a,
  .legal a {
    color: var(--sl-text-2);
    text-decoration: none;
    text-underline-offset: 0.25em;
    overflow-wrap: anywhere;
    transition: color 0.2s var(--sl-ease-out);
  }
  .col a:hover,
  .legal a:hover {
    color: var(--sl-text);
    text-decoration: underline;
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sl-space-3) var(--sl-space-6);
    padding: var(--sl-space-5) 4px 0;
    color: var(--sl-text-2);
  }
  .legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sl-space-2) var(--sl-space-5);
  }

  /* The name, set huge and cut off by the page edge; decoration only, so not real text */
  .wordmark {
    margin-top: var(--sl-space-6);
    margin-bottom: -0.2em;
    font-size: clamp(5.5rem, 22vw, 19rem);
    font-weight: 600;
    letter-spacing: -0.07em;
    line-height: 0.8;
    text-align: center;
    user-select: none;
    pointer-events: none;
  }
  .wordmark::before {
    content: "sitelens";
    background: linear-gradient(180deg, color-mix(in srgb, var(--sl-text) 13%, transparent), transparent 82%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @media (max-width: 959px) {
    .panel { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 599px) {
    .cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cols .col:last-child { grid-column: 1 / -1; }
    .legal { flex-direction: column; align-items: flex-start; }
  }
</style>
