---
import { Image } from 'astro:assets';
import cover from '../../../../public/raport/podglad/raport-strona-1.webp';
import { useTranslations, type Lang } from '../i18n';
import DockIcon, { type DockApp } from './DockIcon.astro';
import Icon3D from './Icon3D.astro';
import TerminalScreen from './TerminalScreen.astro';

interface Props {
  lang: Lang;
}

const s = useTranslations(Astro.props.lang).hero.stage;
const m = s.mac;
const apps: DockApp[] = ['files', 'browser', 'mail', 'notes', 'terminal', 'preview', 'settings'];
---

<figure class="mac stage" data-stage>
  <div class="frame">
    <div class="titlebar" aria-hidden="true">
      <span class="lights"><i class="close"></i><i class="min"></i><i class="max"></i></span>
      <span class="title">{m.windowTitle}</span>
    </div>

    <div class="desktop">
      <div class="wallpaper" aria-hidden="true">
        <svg viewBox="0 0 1400 900" preserveAspectRatio="xMidYMid slice" focusable="false">
          <defs>
            <linearGradient id="wp-a" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" class="wp-s1"></stop>
              <stop offset="1" class="wp-s2"></stop>
            </linearGradient>
            <linearGradient id="wp-b" x1="1" y1="0" x2="0" y2="1">
              <stop offset="0" class="wp-s3"></stop>
              <stop offset="1" class="wp-s4"></stop>
            </linearGradient>
          </defs>
          <path d="M0 520C210 430 380 560 640 470S1080 330 1400 430V900H0Z" fill="url(#wp-a)" opacity="0.75"></path>
          <path d="M0 660C260 560 520 700 820 610S1210 520 1400 590V900H0Z" fill="url(#wp-b)" opacity="0.85"></path>
          <path d="M0 790C300 720 600 820 900 760S1250 700 1400 740V900H0Z" fill="url(#wp-a)" opacity="0.6"></path>
        </svg>
      </div>

      <div class="menubar lens-wide" aria-hidden="true">
        <svg class="mark" viewBox="8 8 184 184" focusable="false"><use href="#logo-nav-art"></use></svg>
        {m.menu.map((item, i) => <span class:list={['menu-item', { app: i === 0 }]}>{item}</span>)}
        <span class="clock">{m.time}</span>
      </div>

      <div class="win term">
        <div class="win-bar" aria-hidden="true">
          <span class="lights small"><i class="close"></i><i class="min"></i><i class="max"></i></span>
          <span class="win-title">{m.terminalTitle}</span>
        </div>
        <TerminalScreen lines={s} animated bar={false} />
      </div>

      <div class="win pdf">
        <div class="win-bar" aria-hidden="true">
          <span class="lights small"><i class="close"></i><i class="min"></i><i class="max"></i></span>
          <span class="win-title">{m.pdfTitle}</span>
        </div>
        <Image class="pdf-page" src={cover} alt={s.coverAlt} widths={[240, 320, 480, 640]} sizes="(min-width: 900px) 300px, 46vw" />
      </div>

      <div class="notif glass lens">
        <Icon3D name="report" size={36} />
        <div class="notif-text">
          <p class="notif-head"><b>{m.notifApp}</b><span>{m.notifTime}</span></p>
          <p class="notif-title">{m.notifTitle}</p>
          <p class="notif-body">{m.notifBody}</p>
        </div>
      </div>

      <div class="dock glass lens-wide" aria-hidden="true">
        {
          apps.map((app) => (
            <span class:list={['app', `app-${app}`]} data-label={m.dock[app]}>
              <DockIcon app={app} />
            </span>
          ))
        }
        <span class="divider"></span>
        <span class="app app-trash" data-label={m.dock.trash}>
          <DockIcon app="trash" />
        </span>
      </div>
    </div>
  </div>

  <figcaption>
    <span>{s.caption}</span>
    <button class="replay lq-btn" type="button" data-replay>
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M13 8a5 5 0 1 1-1.46-3.54M13 2.5v2.5h-2.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      {s.replay}
    </button>
  </figcaption>
</figure>

<style>
  .mac {
    container-type: inline-size;
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
  }

  .frame {
    overflow: hidden;
    border-radius: 22px;
    background: var(--sl-surface);
    box-shadow:
      0 0 0 1px var(--sl-glass-line),
      0 2px 4px color-mix(in srgb, var(--sl-text) 6%, transparent),
      0 60px 140px -40px var(--sl-glow-1),
      var(--sl-shadow-l);
  }

  .titlebar {
    position: relative;
    display: flex;
    align-items: center;
    height: 44px;
    padding: 0 16px;
    border-bottom: 1px solid var(--sl-line);
    background: var(--sl-surface);
  }
  .title {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--sl-text-2);
    font-size: 13px;
    font-weight: 500;
    pointer-events: none;
  }
  .lights {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 8px;
  }
  .lights i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 0.5px color-mix(in srgb, var(--sl-text) 18%, transparent);
  }
  .lights.small { gap: 7px; }
  .lights.small i { width: 11px; height: 11px; }
  .close { background: var(--sl-tl-close); }
  .min { background: var(--sl-tl-min); }
  .max { background: var(--sl-tl-max); }

  .desktop {
    position: relative;
    height: 640px;
    overflow: hidden;
  }

  .wallpaper {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 70% at 16% 26%, var(--sl-prism-1), transparent 70%),
      radial-gradient(55% 60% at 84% 18%, var(--sl-prism-2), transparent 70%),
      radial-gradient(50% 55% at 88% 82%, var(--sl-wp-deep), transparent 72%),
      radial-gradient(70% 60% at 40% 100%, var(--sl-prism-3), transparent 70%),
      linear-gradient(165deg, var(--sl-wp-top), var(--sl-wp-bottom));
  }
  .wallpaper svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .wp-s1 { stop-color: var(--sl-prism-1); }
  .wp-s2 { stop-color: var(--sl-wp-deep); }
  .wp-s3 { stop-color: var(--sl-prism-3); }
  .wp-s4 { stop-color: var(--sl-prism-2); }
  /* Graphite wallpaper in the monochrome dark theme: silver light instead of Pryzmat */
  :global(:root[data-theme="dark"]) .wallpaper {
    background:
      radial-gradient(60% 70% at 16% 26%, color-mix(in srgb, var(--sl-light) 14%, transparent), transparent 70%),
      radial-gradient(55% 60% at 84% 18%, color-mix(in srgb, var(--sl-light) 9%, transparent), transparent 70%),
      radial-gradient(70% 60% at 40% 100%, color-mix(in srgb, var(--sl-light) 10%, transparent), transparent 70%),
      linear-gradient(165deg, var(--sl-wp-top), var(--sl-wp-bottom));
  }
  :global(:root[data-theme="dark"]) .wp-s1 { stop-color: color-mix(in srgb, var(--sl-light) 26%, var(--sl-bg)); }
  :global(:root[data-theme="dark"]) .wp-s3 { stop-color: color-mix(in srgb, var(--sl-light) 16%, var(--sl-bg)); }
  :global(:root[data-theme="dark"]) .wp-s4 { stop-color: color-mix(in srgb, var(--sl-light) 21%, var(--sl-bg)); }

  .menubar {
    position: absolute;
    inset: 0 0 auto;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 18px;
    height: 30px;
    padding: 0 16px;
    background: color-mix(in srgb, var(--sl-surface) 42%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(1.8);
    backdrop-filter: blur(20px) saturate(1.8);
    box-shadow: inset 0 -1px 0 0 var(--sl-glass-line);
    color: var(--sl-text);
    font-size: 13px;
    font-weight: 500;
  }
  .mark {
    width: 17px;
    height: 17px;
    color: var(--sl-text);
  }
  .app { font-weight: 700; }
  .clock {
    margin-left: auto;
    font-variant-numeric: tabular-nums;
  }

  .win {
    position: absolute;
    z-index: 2;
    overflow: hidden;
    border-radius: 14px;
    background: var(--sl-window);
    -webkit-backdrop-filter: blur(32px) saturate(1.9);
    backdrop-filter: blur(32px) saturate(1.9);
    box-shadow:
      inset 1px 1px 0 0 var(--sl-glass-hi),
      0 0 0 1px var(--sl-glass-line),
      0 40px 80px -30px color-mix(in srgb, var(--sl-text) 45%, transparent),
      var(--sl-shadow-m);
  }
  .win-bar {
    position: relative;
    display: flex;
    align-items: center;
    height: 34px;
    padding: 0 12px;
    border-bottom: 1px solid var(--sl-glass-line);
  }
  .win-title {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--sl-text-2);
    font-size: 12px;
    font-weight: 500;
  }
  .term {
    top: 66px;
    left: 6%;
    width: min(560px, 58%);
    font-size: 13.5px;
  }
  .term :global(.screen) { padding-top: 14px; }

  .pdf {
    top: 150px;
    right: 5.5%;
    width: min(300px, 30%);
    transform-origin: 50% 120%;
  }
  .pdf-page {
    display: block;
    width: 100%;
    height: auto;
  }
  :global(:root[data-theme="dark"]) .pdf-page { filter: brightness(0.9); }

  .notif {
    position: absolute;
    top: 42px;
    right: 14px;
    z-index: 4;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    width: min(340px, 42%);
    padding: 12px 16px 12px 12px;
    border-radius: 18px;
    text-align: left;
  }
  .notif-text {
    display: grid;
    gap: 1px;
    min-width: 0;
    font-size: 13px;
    line-height: 1.35;
  }
  .notif-head {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    color: var(--sl-text-2);
    font-size: 12px;
  }
  .notif-head b { color: var(--sl-text); font-weight: 600; }
  .notif-title { font-weight: 600; }

  .dock {
    position: absolute;
    bottom: 12px;
    left: 50%;
    z-index: 3;
    display: flex;
    align-items: flex-end;
    gap: 8px;
    padding: 7px 10px 9px;
    border-radius: 24px;
    translate: -50% 0;
  }
  .dock .app {
    position: relative;
    display: block;
    width: 48px;
    height: 48px;
    transform-origin: 50% 100%;
    transition: transform 0.3s var(--sl-ease-out);
  }
  .dock :global(.dock-icon) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: drop-shadow(0 4px 6px var(--sl-app-shadow));
  }
  /* macOS dock magnification: the hovered icon grows most, its neighbours a little */
  .dock .app:hover { transform: scale(1.32) translateY(-6px); }
  .dock .app:hover + .app,
  .dock .app:has(+ .app:hover) { transform: scale(1.14) translateY(-3px); }
  /* App name above the icon, like the macOS dock tooltip */
  .dock .app::before {
    content: attr(data-label);
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    padding: 3px 10px;
    border-radius: 8px;
    background: var(--sl-lg-tint-strong);
    box-shadow: 0 0 0 1px var(--sl-glass-line), var(--sl-shadow-s);
    color: var(--sl-text);
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    translate: -50% 4px;
    transition: opacity 0.15s var(--sl-ease-out), translate 0.15s var(--sl-ease-out);
  }
  .dock .app:hover::before { opacity: 1; translate: -50% 0; }
  /* Running apps get the small dot under the icon */
  .dock .app::after {
    content: "";
    position: absolute;
    bottom: -6px;
    left: 50%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--sl-text);
    opacity: 0;
    translate: -50% 0;
    transition: opacity 0.3s var(--sl-ease-out);
  }
  .dock .app-terminal::after,
  .stage[data-revealed] .dock .app-preview::after { opacity: 0.75; }
  .divider {
    align-self: stretch;
    width: 1px;
    margin: 4px 2px;
    background: var(--sl-glass-line);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--sl-space-2) var(--sl-space-5);
    margin-top: var(--sl-space-6);
    color: var(--sl-text-2);
    font-size: var(--sl-fs-small);
  }
  .replay {
    display: inline-flex;
    align-items: center;
    gap: var(--sl-space-2);
    height: 36px;
    padding: 0 var(--sl-space-4);
    border: 0;
    border-radius: var(--sl-radius-pill);
    font-size: var(--sl-fs-small);
    font-weight: 500;
    visibility: hidden;
    transition: box-shadow 0.2s var(--sl-ease-out), transform 0.4s var(--sl-ease-spring), --light 0.7s var(--sl-ease-draw);
  }
  .replay:active { transform: scale(0.97); }
  .replay svg { width: 15px; height: 15px; }
  .stage[data-replayable] .replay { visibility: visible; }

  .pdf,
  .notif {
    transition:
      opacity 0.6s var(--sl-ease-out),
      transform var(--sl-dur-spring) var(--sl-ease-spring);
  }
  .notif { transition-delay: 0.35s; }
  .stage[data-revealed] .app-preview { animation: launch 0.9s var(--sl-ease-out); }
  @keyframes launch {
    0%, 100% { transform: translateY(0); }
    30% { transform: translateY(-14px); }
    60% { transform: translateY(0); }
    75% { transform: translateY(-5px); }
  }

  /* Without JS or with reduced motion the scene simply renders finished. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .stage:not([data-played]) :global(.typed) { clip-path: inset(0 100% 0 0); }
    :global(.js) .stage:not([data-played]) :global(.caret-track) { transform: translateX(-100%); }
    :global(.js) .stage:not([data-played]) :global(.caret) { opacity: 1; }
    :global(.js) .stage:not([data-played]) :global(:is(.crawling, .cat, .overall, .saved, .check, .score)) { opacity: 0; }
    :global(.js) .stage:not([data-played]) :global(.ring-arc) { stroke-dashoffset: 100; }
    :global(.js) .stage:not([data-played]) :global(.meter-fill) { transform: scaleX(0); }
    :global(.js) .stage:not([data-revealed]) .pdf { opacity: 0; transform: translateY(40px) scale(0.86); }
    :global(.js) .stage:not([data-revealed]) .notif { opacity: 0; transform: translateX(120%); }
    .stage[data-playing] :global(.spinner) { animation: spin 0.8s linear infinite; }
  }
  @media (prefers-reduced-motion: reduce) {
    .replay { display: none; }
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /*
    Narrow window: the report slides out from under the terminal and stays partly beneath
    its glass, so every terminal line stays readable (the glass is dense enough for 4.5:1).
  */
  @container (max-width: 760px) {
    .desktop { height: clamp(620px, 120cqi, 720px); }
    .menu-item:not(.app) { display: none; }
    .term {
      z-index: 3;
      top: 46px;
      right: 12px;
      left: 12px;
      width: auto;
      font-size: clamp(10.5px, 3.1cqi, 13px);
    }
    .pdf {
      z-index: 2;
      top: auto;
      right: 12px;
      bottom: 84px;
      width: min(44%, 240px);
    }
    /* Too little room on a phone: the notification would cover the command */
    .notif { display: none; }
    .pdf .win-title { display: none; }
    .dock { gap: 5px; padding: 6px 8px 8px; border-radius: 20px; }
    .dock .app { width: 32px; height: 32px; }
    .dock .app-mail,
    .dock .app-notes { display: none; }
  }
</style>
