---
import { pageLinks, routes, useTranslations, type Lang } from '../i18n';
import { rich } from '../lib/rich';

interface Props {
  lang: Lang;
  id: string;
  /** The brandbook page uses the same form with its own wording and target */
  tool?: 'audit' | 'brandbook';
}

const { lang, id, tool = 'audit' } = Astro.props;
const dictionary = useTranslations(lang);
const t = tool === 'brandbook' ? dictionary.brandbookPage.form : dictionary.hero.form;
---

<!-- Plain GET form: works without JavaScript; the target page reads ?url= and starts. -->
<form class="url-form" action={routes[tool][lang]} method="get">
  <div class="row lens-wide">
    <div class="field">
      <label for={id}>{t.label}</label>
      <input
        id={id}
        name="url"
        type="text"
        inputmode="url"
        autocomplete="url"
        autocapitalize="off"
        spellcheck="false"
        placeholder={t.placeholder}
        aria-describedby={`${id}-privacy`}
        required
      />
    </div>
    <button class="btn btn-primary" type="submit">{t.submit}</button>
  </div>
  <p class="privacy" id={`${id}-privacy`} set:html={rich(t.privacy, pageLinks(lang))} />
</form>

<style>
  .url-form {
    display: grid;
    justify-items: center;
    gap: var(--sl-space-4);
    width: 100%;
    max-width: 40rem;
    margin-inline: auto;
  }

  .row {
    display: flex;
    align-items: center;
    gap: var(--sl-space-2);
    width: 100%;
    padding: 8px 8px 8px 28px;
    border: 1px solid var(--sl-field-line);
    border-radius: var(--sl-radius-pill);
    background: var(--sl-glass-card);
    -webkit-backdrop-filter: blur(24px) saturate(1.7);
    backdrop-filter: blur(24px) saturate(1.7);
    box-shadow: inset 0 1px 0 0 var(--sl-lg-rim), var(--sl-shadow-l);
    transition: border-color 0.2s var(--sl-ease-out), box-shadow 0.2s var(--sl-ease-out);
  }
  .row:hover { border-color: var(--sl-text-2); }
  .row:has(input:focus-visible) {
    border-color: var(--sl-accent);
    outline: 3px solid var(--sl-accent);
    outline-offset: 2px;
  }

  .field {
    display: grid;
    flex: 1;
    min-width: 0;
    text-align: left;
  }
  label {
    color: var(--sl-text-2);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
  }
  input {
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--sl-text);
    font-size: 1.125rem;
    line-height: 1.5;
  }
  input:focus { outline: none; }
  input::placeholder { color: var(--sl-text-2); opacity: 1; }

  .privacy {
    max-width: 34rem;
    color: var(--sl-text-2);
    font-size: 13px;
    line-height: 1.5;
    text-align: center;
  }

  @media (max-width: 559px) {
    .row {
      flex-direction: column;
      align-items: stretch;
      padding: 0;
      border: 0;
      background: none;
      box-shadow: none;
    }
    .row:has(input:focus-visible) { outline: none; }
    .field {
      padding: 10px 20px;
      border: 1px solid var(--sl-field-line);
      border-radius: var(--sl-radius-l);
      background: var(--sl-surface);
      box-shadow: var(--sl-shadow-s);
    }
    .field:has(input:focus-visible) {
      border-color: var(--sl-accent);
      outline: 3px solid var(--sl-accent);
      outline-offset: 2px;
    }
    .btn { width: 100%; }
  }
</style>
