---
// The brandbook scene on the homepage: a loupe reads sitelens.pl in a browser window and each
// thing it finds lands in the brandbook beside it. brand-stage.ts plays it.
import tokensCss from '../../../../public/brand/tokens.css?raw';
import { useTranslations, type Lang } from '../i18n';
import { LOGO_VIEWBOX } from '../lib/logo';
import BrandSite from './BrandSite.astro';
import Icon3D from './Icon3D.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const b = t.brandSection.stage;

// The labels show the real values of both themes; CSS shows the pair matching the page
const [lightCss, darkCss] = tokensCss.split(':root[data-theme="dark"]');
const hex = (css: string, token: string) => {
  const value = css.match(new RegExp(`--sl-${token}:\\s*(#[0-9A-Fa-f]{6})`))?.[1];
  if (!value) throw new Error(`public/brand/tokens.css has no --sl-${token} colour for the brandbook scene`);
  return value.toUpperCase();
};
const colors = b.colors.map((c) => ({ ...c, light: hex(lightCss, c.token), dark: hex(darkCss, c.token) }));
const accent = colors.find((c) => c.token === 'accent') ?? colors[0];
const files = ['brandbook.pdf', 'brandbook.html', 'tokens.css', 'tailwind.css'];
---

<figure class="bstage" data-bstage>
  <div class="scene">
    <div class="browser" aria-hidden="true">
      <div class="bar">
        <span class="lights"><i class="close"></i><i class="min"></i><i class="max"></i></span>
        <span class="address">
          <svg viewBox="0 0 16 16" focusable="false"><path d="M5 7V5.5a3 3 0 0 1 6 0V7M4.5 7h7a1 1 0 0 1 1 1v4.5a1 1 0 0 1-1 1h-7a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path></svg>
          sitelens.pl
        </span>
      </div>
      <div class="page" data-page>
        <BrandSite title={t.hero.title} button={t.hero.form.submit} />
        <div class="loupe" data-loupe>
          <div class="glass-disc">
            <div class="view" data-view><BrandSite title={t.hero.title} button={t.hero.form.submit} /></div>
          </div>
          <span class="readout">
            <span>logo.svg</span>
            <span>Geist 600</span>
            <span>radius 9999px</span>
            <span><b class="v-light">{accent.light}</b><b class="v-dark">{accent.dark}</b></span>
          </span>
        </div>
      </div>
    </div>

    <div class="sheet">
      <p class="sheet-head">
        <Icon3D name="palette" size={36} />
        <b>{b.panel}</b>
        <span>sitelens.pl</span>
      </p>

      <div class="grp" data-step="0">
        <p class="grp-title">{b.groups.logo}</p>
        <div class="logos">
          <span class="logo-tile pop">
            <svg viewBox={LOGO_VIEWBOX} role="img" aria-label={b.logoOnLight}><use href="#logo-nav-art"></use></svg>
          </span>
          <span class="logo-tile on-accent pop">
            <svg viewBox={LOGO_VIEWBOX} role="img" aria-label={b.logoOnAccent}><use href="#logo-nav-art"></use></svg>
          </span>
        </div>
      </div>

      <div class="grp" data-step="1">
        <p class="grp-title">{b.groups.type}</p>
        <div class="fonts">
          <p class="font pop"><span class="aa" aria-hidden="true">Aa</span><b>Geist</b><span>{b.fonts.sans}</span></p>
          <p class="font mono pop"><span class="aa" aria-hidden="true">Aa</span><b>Geist Mono</b><span>{b.fonts.mono}</span></p>
        </div>
      </div>

      <div class="grp" data-step="2">
        <p class="grp-title">{b.groups.ui}</p>
        <p class="ui">
          <span class="sample-field pop">{t.hero.form.placeholder}</span>
          <span class="sample-btn pop">{t.hero.form.submit}</span>
          <code class="pop">border-radius: 9999px</code>
        </p>
      </div>

      <div class="grp" data-step="3">
        <p class="grp-title">{b.groups.colors}</p>
        <ul class="colors" role="list">
          {
            colors.map((c) => (
              <li class="pop">
                <i class:list={['chip', `c-${c.token}`]} />
                <b>{c.name}</b>
                <span class="hex v-light">{c.light}</span>
                <span class="hex v-dark">{c.dark}</span>
              </li>
            ))
          }
        </ul>
      </div>


      <div class="grp" data-step="4">
        <p class="grp-title">{b.groups.files}</p>
        <ul class="files" role="list">
          {
            files.map((name) => (
              <li class="pop">
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                  <path d="M4 1.75h5.25L12.5 5v9.25h-8.5Z M9 1.75V5.25h3.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                </svg>
                {name}
              </li>
            ))
          }
        </ul>
        <p class="summary pop">{b.summary}</p>
      </div>
    </div>
  </div>

  <figcaption>
    <span>{b.caption}</span>
    <button class="replay lq-btn" type="button" data-replay>
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M13 8a5 5 0 1 1-1.46-3.54M13 2.5v2.5h-2.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      {t.hero.stage.replay}
    </button>
  </figcaption>
</figure>

<style>
  .bstage {
    container-type: inline-size;
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
  }

  .scene {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: start;
    padding: 56px 5% 48px;
    overflow: hidden;
    border-radius: 28px;
    background:
      radial-gradient(60% 70% at 12% 20%, var(--sl-prism-1), transparent 70%),
      radial-gradient(55% 60% at 90% 12%, var(--sl-prism-2), transparent 70%),
      radial-gradient(70% 60% at 50% 110%, var(--sl-prism-3), transparent 70%),
      linear-gradient(165deg, var(--sl-wp-top), var(--sl-wp-bottom));
    box-shadow:
      0 0 0 1px var(--sl-glass-line),
      0 60px 140px -40px var(--sl-glow-1),
      var(--sl-shadow-l);
  }
  /* Graphite light in the monochrome dark theme, like the hero wallpaper */
  :global(:root[data-theme="dark"]) .scene {
    background:
      radial-gradient(60% 70% at 12% 20%, color-mix(in srgb, var(--sl-light) 14%, transparent), transparent 70%),
      radial-gradient(55% 60% at 90% 12%, color-mix(in srgb, var(--sl-light) 9%, transparent), transparent 70%),
      radial-gradient(70% 60% at 50% 110%, color-mix(in srgb, var(--sl-light) 10%, transparent), transparent 70%),
      linear-gradient(165deg, var(--sl-wp-top), var(--sl-wp-bottom));
  }

  .browser,
  .sheet {
    overflow: hidden;
    border-radius: 16px;
    background: var(--sl-window);
    -webkit-backdrop-filter: blur(32px) saturate(1.9);
    backdrop-filter: blur(32px) saturate(1.9);
    box-shadow:
      inset 1px 1px 0 0 var(--sl-glass-hi),
      0 0 0 1px var(--sl-glass-line),
      0 40px 80px -30px color-mix(in srgb, var(--sl-text) 45%, transparent),
      var(--sl-shadow-m);
  }
  .browser { margin-top: 40px; }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    height: 40px;
    padding: 0 14px;
    border-bottom: 1px solid var(--sl-glass-line);
  }
  .lights {
    display: flex;
    gap: 7px;
  }
  .lights i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 0.5px color-mix(in srgb, var(--sl-text) 18%, transparent);
  }
  .close { background: var(--sl-tl-close); }
  .min { background: var(--sl-tl-min); }
  .max { background: var(--sl-tl-max); }
  .address {
    position: absolute;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 6px;
    height: 26px;
    padding: 0 14px;
    border-radius: 99px;
    background: color-mix(in srgb, var(--sl-text) 6%, transparent);
    color: var(--sl-text);
    font-size: 13px;
    translate: -50% 0;
  }
  .address svg { width: 12px; height: 12px; color: var(--sl-text-2); }

  .page {
    position: relative;
    overflow: hidden;
    container-type: inline-size;
  }

  .loupe {
    --r: clamp(46px, 11cqi, 74px);
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    width: calc(var(--r) * 2);
    height: calc(var(--r) * 2);
  }
  .glass-disc {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 50%;
    box-shadow:
      0 0 0 3px var(--sl-surface),
      0 0 0 4px var(--sl-glass-line),
      0 18px 40px -12px color-mix(in srgb, var(--sl-shade) 45%, transparent);
  }
  /* A glint across the top of the glass */
  .glass-disc::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(80% 60% at 30% 12%, var(--sl-lq-spec-soft), transparent 55%);
    box-shadow: inset 0 0 0 1px var(--sl-glass-hi), inset 0 -10px 24px -14px color-mix(in srgb, var(--sl-shade) 40%, transparent);
    pointer-events: none;
  }
  /* The handle */
  .loupe::after {
    content: "";
    position: absolute;
    top: 88%;
    left: 88%;
    width: calc(var(--r) * 0.24);
    height: calc(var(--r) * 0.8);
    border-radius: 99px;
    background: linear-gradient(90deg, var(--sl-text), var(--sl-text-2));
    box-shadow: var(--sl-shadow-m);
    rotate: -45deg;
    transform-origin: 50% 0;
  }
  .view {
    position: absolute;
    top: 0;
    left: 0;
    width: 100cqi;
    container-type: inline-size;
    transform-origin: 0 0;
  }
  /* Centred under the glass, clear of the handle on the right */
  .readout {
    position: absolute;
    top: calc(100% + 18px);
    left: 50%;
    display: grid;
    translate: -50% 0;
  }
  .readout > span {
    grid-area: 1 / 1;
    justify-self: center;
    padding: 4px 10px;
    border-radius: 99px;
    background: var(--sl-lg-tint-strong);
    box-shadow: 0 0 0 1px var(--sl-glass-line), var(--sl-shadow-s);
    color: var(--sl-text);
    font-family: var(--sl-font-mono);
    font-size: 12px;
    white-space: nowrap;
    opacity: 0;
  }
  .readout b { font-weight: 500; }
  .bstage[data-played] .readout > span:last-child { opacity: 1; }
  /* Without JS the loupe has nowhere to stand, so the browser shows the page alone */
  .bstage:not([data-placed]) .loupe { visibility: hidden; }

  .sheet {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 16px;
    margin-left: -28px;
    padding: 16px 20px 20px;
    font-size: 13px;
    line-height: 1.35;
  }
  .sheet-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--sl-glass-line);
    font-size: 15px;
  }
  .sheet-head span {
    margin-left: auto;
    color: var(--sl-text-2);
    font-size: 13px;
  }
  .grp {
    display: grid;
    gap: 8px;
  }
  .grp-title {
    color: var(--sl-text-2);
    font-size: 12px;
    font-weight: 500;
  }

  .logos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .logo-tile {
    display: grid;
    place-items: center;
    height: 48px;
    padding: 0 12px;
    border-radius: 10px;
    background: var(--sl-surface);
    box-shadow: inset 0 0 0 1px var(--sl-line);
    color: var(--sl-text);
  }
  .logo-tile.on-accent {
    background: linear-gradient(160deg, var(--sl-icon-plate-hi), var(--sl-icon-plate-mid) 55%, var(--sl-icon-plate-lo));
    box-shadow: none;
    color: var(--sl-light);
  }
  .logo-tile svg { width: 100%; max-width: 96px; height: auto; }

  .fonts {
    display: grid;
    gap: 6px;
  }
  .font {
    display: grid;
    grid-template-columns: 44px 1fr;
    column-gap: 10px;
    align-items: center;
  }
  .font .aa {
    grid-row: span 2;
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .font.mono .aa,
  .font.mono b { font-family: var(--sl-font-mono); }
  .font.mono .aa { font-weight: 500; letter-spacing: 0; }
  .font b { font-weight: 600; }
  .font > span:last-child { color: var(--sl-text-2); font-size: 12px; }

  .colors {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .colors li {
    display: grid;
    gap: 2px;
    font-size: 12px;
  }
  .chip {
    height: 26px;
    margin-bottom: 4px;
    border-radius: 8px;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--sl-text) 14%, transparent);
  }
  .c-accent { background: var(--sl-accent); }
  .c-text { background: var(--sl-text); }
  .c-text-2 { background: var(--sl-text-2); }
  .c-line { background: var(--sl-line); }
  .c-bg { background: var(--sl-bg); }
  .c-surface { background: var(--sl-surface); }
  .colors b { font-weight: 600; }
  .hex { color: var(--sl-text-2); font-family: var(--sl-font-mono); }
  .v-dark { display: none; }
  :global(:root[data-theme="dark"]) .v-light { display: none; }
  :global(:root[data-theme="dark"]) .v-dark { display: inline; }

  .ui {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }
  .sample-btn {
    display: inline-grid;
    place-items: center;
    height: 32px;
    padding: 0 16px;
    border-radius: 99px;
    background: var(--sl-btn-bg);
    color: var(--sl-btn-text);
    font-weight: 600;
  }
  .sample-field {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 14px;
    border-radius: 99px;
    background: var(--sl-surface);
    box-shadow: inset 0 0 0 1px var(--sl-field-line);
    color: var(--sl-text-2);
  }
  .ui code { color: var(--sl-text-2); font-size: 12px; }

  .files {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .files li {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 26px;
    padding: 0 10px 0 8px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--sl-text) 6%, transparent);
    font-family: var(--sl-font-mono);
    font-size: 12px;
  }
  .files svg { width: 13px; height: 13px; color: var(--sl-accent); }
  .summary { color: var(--sl-text-2); font-size: 12px; }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--sl-space-2) var(--sl-space-5);
    margin-top: var(--sl-space-6);
    color: var(--sl-text-2);
    font-size: var(--sl-fs-small);
  }
  .replay {
    display: inline-flex;
    align-items: center;
    gap: var(--sl-space-2);
    height: 36px;
    padding: 0 var(--sl-space-4);
    border: 0;
    border-radius: var(--sl-radius-pill);
    font-size: var(--sl-fs-small);
    font-weight: 500;
    visibility: hidden;
    transition: box-shadow 0.2s var(--sl-ease-out), transform 0.4s var(--sl-ease-spring), --light 0.7s var(--sl-ease-draw);
  }
  .replay:active { transform: scale(0.97); }
  .replay svg { width: 15px; height: 15px; }
  .bstage[data-replayable] .replay { visibility: visible; }

  /* Without JS or with reduced motion the brandbook simply renders finished */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .bstage:not([data-played]) .pop { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .replay { display: none; }
  }

  @container (max-width: 760px) {
    .scene {
      grid-template-columns: minmax(0, 1fr);
      padding: 20px 12px 12px;
    }
    .browser { margin-top: 0; }
    /* Barely overlapping, so the reading under the loupe stays in view */
    .sheet {
      margin: -8px 10px 0;
      padding: 14px 16px 16px;
    }
  }
</style>
