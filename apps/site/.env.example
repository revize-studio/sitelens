# The online audit at /audyt turns on only when all three are set (Vercel: Project → Settings →
# Environment Variables). They are public values, visible in the page; secrets stay in the Worker.
# Address of the deployed apps/proxy Worker, without a trailing slash
PUBLIC_PROXY_URL=
# Turnstile widget site key (Cloudflare dashboard → Turnstile); for localhost: 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
# Google PageSpeed Insights API key, restricted to sitelens.pl/* and to the PageSpeed Insights API
PUBLIC_PSI_KEY=
